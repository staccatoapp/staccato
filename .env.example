# Host-side paths consumed by docker-compose for volume mount sources.
# Both are required by docker-compose.yml; copy this file to `.env` and edit.

# Where Staccato persists its data (DB + metadata cache) on the host.
# Inside the container this is mounted at /data and exposed to the app via
# STACCATO_DATA_DIR=/data.
DATA_PATH=./data

# Host path to your music library. Mounted read-only at /music inside the
# container; the app reads it via STACCATO_SERVER_MUSIC_DIR=/music.
MUSIC_PATH=./music
