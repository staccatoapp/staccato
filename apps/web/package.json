{
  "name": "@staccato/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:remote": "vite --host",
    "build": "tsc -b && vite build",
    "check-types": "tsc -b",
    "lint": "eslint src/ --max-warnings=0 && prettier --check src/ --ignore-path ../../.prettierignore",
    "lint:fix": "eslint src/ --max-warnings=0 --fix && prettier --write src/ --ignore-path ../../.prettierignore",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@dnd-kit/helpers": "0.4.0",
    "@dnd-kit/react": "0.4.0",
    "@fastify/static": "^9.1.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@staccato/shared": "workspace:*",
    "@tanstack/react-query": "^5.99.2",
    "@tanstack/react-router": "^1.168.23",
    "@tanstack/react-router-devtools": "^1.166.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@staccato/eslint-config": "workspace:*",
    "@staccato/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/eslint-plugin-query": "^5.99.2",
    "@tanstack/router-plugin": "^1.167.22",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.4.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.7"
  }
}
