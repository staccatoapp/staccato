{
  "name": "@staccato/metadata-service",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --inspect=9330 src/index.ts --name=metadata",
    "dev:remote": "tsx watch --inspect=9330 src/index.ts --name=metadata",
    "lint": "eslint src/ --max-warnings=0 && prettier --check src/ --ignore-path ../../.prettierignore",
    "lint:fix": "eslint src/ --max-warnings=0 --fix && prettier --write src/ --ignore-path ../../.prettierignore",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@staccato/shared": "workspace:*",
    "dotenv-flow": "^4.1.0",
    "fastify": "^5.8.5",
    "lru-cache": "^11.0.0",
    "p-queue": "^8.0.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.2.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@staccato/eslint-config": "workspace:*",
    "@staccato/typescript-config": "workspace:*",
    "@types/dotenv-flow": "^3.3.3",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.7"
  }
}
